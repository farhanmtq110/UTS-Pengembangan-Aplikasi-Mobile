<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bayangan tipis di bawah agar tombol terlihat timbul dan tidak terpotong -->
    <item android:top="2dp" android:left="1dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Lapisan utama tombol -->
    <item android:top="0dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#F5F7F8" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#E0E4E6" />
        </shape>
    </item>

</layer-list>