<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lapisan Bayangan di Bawah (Dilebarkan sedikit ke bawah agar tidak terpotong) -->
    <item android:top="3dp" android:left="1dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" /> <!-- Bayangan tipis transparan -->
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- Lapisan Utama Kotak Input (Warna Abu-Abu Lembut) -->
    <item android:top="0dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#F5F7F8" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#E0E4E6" />
        </shape>
    </item>

</layer-list>