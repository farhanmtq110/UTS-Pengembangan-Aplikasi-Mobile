<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_tea"
        android:contentDescription="Background Kafe" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#990F3D3A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tea"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FDFBF7"
            app:cardCornerRadius="28dp"
            app:cardElevation="16dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:paddingBottom="40dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">

                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/circle_bg"
                    android:backgroundTint="#0F3D3A"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:elevation="4dp">

                    <ImageView
                        android:layout_width="85dp"
                        android:layout_height="85dp"
                        android:background="@drawable/circle_bg"
                        android:contentDescription="Logo Kopi dan Nyemil"
                        android:padding="2dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/tea_cup" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kopi &amp; Nyemil"
                    android:textColor="#6C151E"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="36dp"
                    android:gravity="center"
                    android:text="Sipping happiness, one cup at a time"
                    android:textColor="#0F3D3A"
                    android:textSize="14sp"
                    android:textStyle="italic" />

                <Button
                    android:id="@+id/btnStartNow"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:backgroundTint="#6C151E"
                    android:elevation="8dp"
                    android:translationZ="4dp"
                    android:text="Start Now"
                    android:textColor="#F5DABF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</RelativeLayout>